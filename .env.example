# Nome e versão da aplicação.
APP_NAME=DataMind AI Studio
APP_VERSION=0.1.0
ENVIRONMENT=development

# URL de conexão utilizada dentro da rede Docker.
DATABASE_URL=postgresql+psycopg://datamind:datamind_dev@postgres:5432/datamind

# Senha de desenvolvimento do PostgreSQL.
# Altere antes de utilizar o projeto em um ambiente compartilhado.
POSTGRES_PASSWORD=datamind_dev

# E-mail utilizado para entrar no pgAdmin
PGADMIN_DEFAULT_EMAIL=thiago@email.com

# Defina uma senha própria para o pgAdmin
PGADMIN_DEFAULT_PASSWORD=password